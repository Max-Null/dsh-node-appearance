{
  "name": "@max-null/dsh-node-appearance",
  "version": "0.2.1",
  "description": "会话节点外观插件：按节点类型/工具名着色的可配置配色，思考过程显示开关（DeepSeek Harness Web GUI）",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "chat",
    "theme",
    "color",
    "plugin",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Null/dsh-node-appearance.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=0.1.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7",
    "@types/node": "^26.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
